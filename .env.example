# Contoh variabel environment. Tidak ada yang rahasia: semua nilai VITE_* ikut terbaca di browser.
# File yang dipakai Vite sesuai mode:
#   npm run dev            → .env.development
#   npm run build:staging  → .env.staging
#   npm run build          → .env.production
# Override pribadi (tidak di-commit): .env.local atau .env.<mode>.local

# development | staging | production. Selain production, situs menampilkan badge DEV/STAGING.
VITE_APP_ENV=development

# Domain untuk canonical, og:url/og:image, sitemap.xml, robots.txt, JSON-LD.
# Kosong = pakai Pengaturan Situs → Alamat website (siteUrl) dari Pages CMS.
VITE_SITE_URL=http://localhost:5173

# Token Cloudflare Web Analytics (gratis). Hanya dipasang saat VITE_APP_ENV=production. Kosong = nonaktif.
VITE_CF_ANALYTICS_TOKEN=

# Pemeriksaan "siap tayang" (nomor contoh, TODO, cabang Aktif tanpa WA/jam):
#   strict = build gagal, warn = hanya peringatan + badge.
CONTENT_CHECK=warn

