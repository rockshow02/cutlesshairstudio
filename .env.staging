# npm run build:staging → Worker cutlesshairstudio-staging (tidak diindeks mesin pencari)
VITE_APP_ENV=staging
VITE_SITE_URL=https://cutlesshairstudio-staging.adi-yansyaaah.workers.dev
VITE_CF_ANALYTICS_TOKEN=
# Konten boleh belum lengkap di staging: masalah "siap tayang" tampil di badge, build tetap jalan
CONTENT_CHECK=warn

# Booking online (Worker API + D1). true = data cabang/barber/harga dari API & tombol booking ke /booking/.
# Produksi tetap false sampai klien menyetujui (lihat docs/booking-setup.md).
VITE_BOOKING_ENABLED=true
