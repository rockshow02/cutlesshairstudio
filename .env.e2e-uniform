# npm run e2e:server:uniform → build E2E varian "uniform" (Daftar Harga sama di semua cabang, Cuci Sepatu tanpa
# Logo hero) di dist-e2e-uniform/,
# dilayani vite preview di :8788 (tes e2e/branch-pricing.spec.ts). Hanya untuk tes lokal & CI, tidak pernah di-deploy.
VITE_APP_ENV=staging
VITE_SITE_URL=http://localhost:8788
VITE_CF_ANALYTICS_TOKEN=
CONTENT_CHECK=warn
E2E_FIXTURES=1
E2E_VARIANT=uniform
