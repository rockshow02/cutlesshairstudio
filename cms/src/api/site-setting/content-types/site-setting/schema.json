{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Pengaturan Situs",
    "description": "Logo, kontak, sosial media, alamat, dan jam buka."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "siteName": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "mainWhatsappNumber": {
      "type": "string",
      "required": true,
      "regex": "^62\\d{8,13}$",
      "maxLength": 15
    },
    "defaultWaMessage": {
      "type": "text",
      "maxLength": 500
    },
    "instagramUrl": {
      "type": "string",
      "maxLength": 200
    },
    "tiktokUrl": {
      "type": "string",
      "maxLength": 200
    },
    "googleMapsUrl": {
      "type": "string",
      "maxLength": 500
    },
    "address": {
      "type": "text",
      "maxLength": 300
    },
    "footerText": {
      "type": "text",
      "maxLength": 300
    },
    "openingHours": {
      "type": "component",
      "repeatable": true,
      "component": "shared.opening-hour"
    }
  }
}
