{
  "kind": "collectionType",
  "collectionName": "promos",
  "info": {
    "singularName": "promo",
    "pluralName": "promos",
    "displayName": "Promo",
    "description": "Promo berbatas waktu. Tampil hanya bila aktif, sudah dipublikasikan, dan dalam rentang tanggal."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "description": {
      "type": "text",
      "maxLength": 400
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "ctaLabel": {
      "type": "string",
      "default": "Ambil Promo",
      "maxLength": 40
    },
    "waMessage": {
      "type": "text",
      "maxLength": 500
    },
    "startDate": {
      "type": "datetime",
      "required": true
    },
    "endDate": {
      "type": "datetime",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
