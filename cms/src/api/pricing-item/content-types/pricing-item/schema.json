{
  "kind": "collectionType",
  "collectionName": "pricing_items",
  "info": {
    "singularName": "pricing-item",
    "pluralName": "pricing-items",
    "displayName": "Daftar Harga",
    "description": "Harga layanan & paket yang tampil di website."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "default": "Haircut",
      "enum": [
        "Haircut",
        "Shaving",
        "Coloring",
        "Treatment",
        "Kids",
        "Paket"
      ]
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "priceFrom": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "text",
      "maxLength": 300
    },
    "badge": {
      "type": "enumeration",
      "enum": [
        "Best Seller",
        "Baru",
        "Promo"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
