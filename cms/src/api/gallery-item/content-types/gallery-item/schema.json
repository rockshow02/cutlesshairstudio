{
  "kind": "collectionType",
  "collectionName": "gallery_items",
  "info": {
    "singularName": "gallery-item",
    "pluralName": "gallery-items",
    "displayName": "Galeri",
    "description": "Foto hasil potongan untuk section Galeri."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "altText": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "styleCategory": {
      "type": "enumeration",
      "default": "Lainnya",
      "enum": [
        "Fade",
        "Pompadour",
        "Crop",
        "Coloring",
        "Perming",
        "Lainnya"
      ]
    },
    "caption": {
      "type": "string",
      "maxLength": 120
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
