{
  "kind": "collectionType",
  "collectionName": "barbers",
  "info": {
    "singularName": "barber",
    "pluralName": "barbers",
    "displayName": "Barber",
    "description": "Hairstylist yang tampil di website, lengkap dengan tombol booking."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 60
    },
    "role": {
      "type": "string",
      "maxLength": 60
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "specialty": {
      "type": "string",
      "maxLength": 120
    },
    "whatsappNumber": {
      "type": "string",
      "regex": "^62\\d{8,13}$",
      "maxLength": 15
    },
    "instagram": {
      "type": "string",
      "maxLength": 200
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
