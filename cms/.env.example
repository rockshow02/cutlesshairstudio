# ===== Server =====
HOST=0.0.0.0
PORT=1337
# URL publik CMS di production, mis. https://cms.cutlesshairstudio.id (kosongkan saat lokal)
PUBLIC_URL=
# true bila berada di belakang reverse proxy / load balancer (Railway, Render, Nginx)
IS_PROXIED=false

# ===== CORS: domain frontend yang boleh mengakses API (pisahkan dengan koma) =====
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ===== Secrets (WAJIB diganti; buat dengan: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))") =====
APP_KEYS=gantiDenganKunci1,gantiDenganKunci2,gantiDenganKunci3,gantiDenganKunci4
API_TOKEN_SALT=gantiDenganSalt
ADMIN_JWT_SECRET=gantiDenganSecret
TRANSFER_TOKEN_SALT=gantiDenganSalt
JWT_SECRET=gantiDenganSecret
ENCRYPTION_KEY=gantiDenganKunci

# ===== Database =====
# sqlite untuk lokal, postgres untuk production
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# --- Postgres (isi salah satu: DATABASE_URL atau detail di bawahnya) ---
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cutless_cms
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ===== Media: Cloudinary (isi untuk production; kosong = simpan lokal di public/uploads) =====
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=cutless

# ===== Seed =====
# Lokasi folder frontend (relatif ke folder cms) untuk mengambil konten & gambar awal
SEED_FRONTEND_DIR=../frontend
