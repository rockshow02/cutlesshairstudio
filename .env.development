# npm run dev / npm run dev:sync (lokal)
VITE_APP_ENV=development
VITE_SITE_URL=http://localhost:5173
VITE_CF_ANALYTICS_TOKEN=
CONTENT_CHECK=warn

# Booking online (Worker API + D1). true = data cabang/barber/harga dari API & tombol booking ke /booking/.
# Produksi tetap false sampai klien menyetujui (lihat docs/booking-setup.md).
VITE_BOOKING_ENABLED=true
