# npm run build → Worker cutlesshairstudio (produksi)
VITE_APP_ENV=production
# Kosong = domain dari Pengaturan Situs → Alamat website (dikelola pemilik lewat Pages CMS)
VITE_SITE_URL=
# Isi token dari Cloudflare → Analytics & Logs → Web Analytics → Add a site (opsional)
VITE_CF_ANALYTICS_TOKEN=
# Produksi wajib bersih: konten belum siap tayang → build gagal, versi lama tetap tayang
CONTENT_CHECK=strict

