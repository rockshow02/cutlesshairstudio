# npm run build → Worker cutlesshairstudio (produksi)
VITE_APP_ENV=production
# Kosong = domain dari Pengaturan Situs → Alamat website (dikelola pemilik lewat Pages CMS).
# Saat launch: Alamat website = https://cutlesshairstudio.com (belum diaktifkan; lihat docs/migrasi-akun-klien.md → Domain & DNS)
VITE_SITE_URL=
# Token Cloudflare Web Analytics (Analytics & Logs → Web Analytics → situs → Manage site → JS snippet). Bukan rahasia:
# token ini memang tampil di HTML setiap halaman. Kosong = beacon tidak dipasang. Hanya dipakai build produksi.
VITE_CF_ANALYTICS_TOKEN=9ef678dafb0e4fa08b5de0167c57b8e2
# Produksi wajib bersih: konten belum siap tayang → build gagal, versi lama tetap tayang
CONTENT_CHECK=strict

