{
  "name": "cutless-hair-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:sync": "node scripts/dev-sync.mjs",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "tsc -b && vite build --mode production",
    "build:staging": "node scripts/optimize-images.mjs && tsc -b && vite build --mode staging",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "check:content": "node scripts/check-content.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "sync-cms": "node scripts/sync-pages-config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --env staging --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:seed:local": "node scripts/seed-d1.mjs --out seed/seed.local.sql --test-data --dev-admin --apply local",
    "db:seed:staging": "node scripts/seed-d1.mjs --out seed/seed.staging.sql --test-data --apply staging",
    "test": "vitest run",
    "dev:api": "wrangler dev --env staging --port 8787",
    "dev:worker": "npm run build:staging && wrangler dev --env staging --port 8787",
    "preview:worker": "npm run dev:worker",
    "e2e": "playwright test",
    "export-catalog": "node scripts/export-catalog.mjs"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lenis": "^1.3.27",
    "motion": "^14.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swiper": "^11.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sharp": "^0.35.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.86.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
